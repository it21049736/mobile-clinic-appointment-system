NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mobile-clinic
JWT_SECRET=your_jwt_secret_key_here
# Optional locally, required on the hosted server so images survive restarts.
# Copy "API environment variable" from the Cloudinary dashboard.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
